# LLM Provider
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o

# Redis (短期记忆)
REDIS_URL=redis://localhost:6379/0

# Vector Store (长期记忆)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Incremental Index (增量索引)
INCREMENTAL_INDEX_ENABLED=1         # 1=增量(默认) | 0=全量重建
INDEX_MANIFEST_PATH=./vector_store/index_manifest.json

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=smart-cs-multi-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# Knowledge Graph (知识图谱)
GRAPH_STORE_PATH=./graph_store/graph.json
GRAPH_BACKEND=networkx        # networkx (嵌入式) | neo4j (未来升级)

# Multi-modal (多模态)
VISION_MODEL_NAME=gpt-4o      # 必须支持视觉的多模态模型
MAX_IMAGE_SIZE_MB=10

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Embedding mode — hash | openai | bge
#   hash   — 确定性随机向量，零依赖，无语义（仅调试用）
#   openai — text-embedding-3-small，1536维，需 API key
#   bge    — BAAI/bge-small-zh-v1.5，512维，免费离线，中文最优
EMBEDDING_MODE=hash

# Server
HOST=0.0.0.0
PORT=8000
